# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# PostHog (NEXT_PUBLIC_ prefix = available client-side)
NEXT_PUBLIC_POSTHOG_KEY=phc_your-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Site
NEXT_PUBLIC_SITE_URL=https://yourphotoboothdomain.com

# Google Analytics
NEXT_PUBLIC_GA_ID=G-ZW8NWPXGTX


# Sanity CMS — lets the client edit site content at /studio.
# Leave these blank to keep the site running on the built-in default content.
# Find the project ID at https://www.sanity.io/manage after creating a project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Only needed if your dataset is private (a public dataset needs no token).
SANITY_API_READ_TOKEN=

# Write token — used ONLY by the one-time `npm run seed` script. Do not deploy.
SANITY_API_WRITE_TOKEN=

# Shared secret for the publish webhook (/api/revalidate). Make up any string
# and set the same value in the Sanity webhook config for instant updates.
SANITY_REVALIDATE_SECRET=
